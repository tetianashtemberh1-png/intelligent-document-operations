    {
      "parameters": {
        "jsCode": "const input=$json.body??$json; const clean=v=>typeof v==='string'?v.trim():v; const num=v=>{if(v===''||v===null||v===undefined)return null;const n=Number(v);return Number.isFinite(n)?n:null;};\nconst document={document_id:clean(input.document_id??''),document_type:String(clean(input.document_type??'')).toUpperCase(),source:clean(input.source??'unknown'),supplier:clean(input.supplier??''),reference:clean(input.reference??''),issue_date:clean(input.issue_date??''),due_date:clean(input.due_date??''),currency:String(clean(input.currency??'')).toUpperCase(),subtotal:num(input.subtotal),tax:num(input.tax),total:num(input.total),extraction_confidence:num(input.extraction_confidence)};\nconst errors=[],supported=['INVOICE','PURCHASE_ORDER','FORM'];\nif(!document.document_id)errors.push('document_id is required'); if(!document.document_type)errors.push('document_type is required'); else if(!supported.includes(document.document_type))errors.push('unsupported document_type'); if(!document.reference)errors.push('reference is required'); if(!document.issue_date)errors.push('issue_date is required');\nif(document.document_type==='INVOICE'){if(!document.supplier)errors.push('supplier is required for invoice');if(!document.currency)errors.push('currency is required for invoice');if(document.total===null||document.total<=0)errors.push('positive total is required for invoice');}\nreturn [{json:{valid:errors.length===0,errors,document}}];"
      },
      "id": "normalize",
      "name": "Normalize + Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "v",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "valid",
      "name": "Valid Document?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -640,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const d=$json.document,reasons=[],warnings=[]; const s=[d.document_type,d.supplier,d.reference,d.issue_date,d.currency,d.total].join('|').toLowerCase(); let hash=2166136261; for(let i=0;i<s.length;i++){hash^=s.charCodeAt(i);hash=Math.imul(hash,16777619);} const fingerprint=`doc_${(hash>>>0).toString(16).padStart(8,'0')}`;\nif(d.document_type==='INVOICE'){if(d.subtotal!==null&&d.tax!==null&&d.total!==null){const expected=d.subtotal+d.tax;if(Math.abs(expected-d.total)>.01)reasons.push(`invoice arithmetic mismatch: subtotal + tax = ${expected}, total = ${d.total}`);}else warnings.push('subtotal/tax arithmetic check not available'); if(d.issue_date&&d.due_date){const issue=Date.parse(d.issue_date),due=Date.parse(d.due_date);if(Number.isFinite(issue)&&Number.isFinite(due)&&due<issue)reasons.push('due date is earlier than issue date');} if(d.total!==null&&d.total>=10000)reasons.push('high-value invoice requires approval');}\nif(d.extraction_confidence!==null&&d.extraction_confidence<.85)reasons.push('low extraction confidence'); const needs_human_review=reasons.length>0; return [{json:{...$json,fingerprint,exception_reasons:reasons,warnings,needs_human_review,processing_status:needs_human_review?'REQUIRES_HUMAN_REVIEW':'AUTO_READY'}}];"
      },
      "id": "rules",
      "name": "Business Rules + Fingerprint",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
